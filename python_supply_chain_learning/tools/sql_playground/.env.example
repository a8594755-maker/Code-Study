DATABASE_SCHEMA=olist
PORT=3001

# Supabase Auth, authenticated read-only RPC, account logs, and progress.
# This client key is public configuration; RLS and database grants enforce access.
SUPABASE_URL=https://ylmuvsdegmpoiygbtipi.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Server-only OpenAI credential. Never expose this through a VITE_* variable.
# Production can instead keep the valid OPENAI_API_KEY in Supabase Secrets and
# use the sql-analyst-tutor Edge Function through a shared proxy secret.
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_TUTOR_MODEL=gpt-5.6-luna
TUTOR_PROXY_SECRET=replace_with_random_server_only_proxy_secret
# Optional independent editor-tutor proxy secret. Omit locally to derive from OPENAI_API_KEY.
# Hosted Preview uses a real value in deployment Secrets, never a VITE_* variable.
EDITOR_TUTOR_PROXY_SECRET=
